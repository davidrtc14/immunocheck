# Nunca coloque valores reais neste arquivo versionado.
POSTGRES_DB=immunocheck
POSTGRES_USER=immunocheck
POSTGRES_PASSWORD=immunocheck-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://immunocheck:immunocheck-local-only@localhost:5432/immunocheck
TELEGRAM_BOT_TOKEN=
# Opcional: IDs de chat permitidos, separados por vírgula (vazio = qualquer chat).
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_RATE_LIMIT_MESSAGES=5
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
TESSERACT_CMD=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# v7 = cascata C6 (ADR-055): v3 + verificação dos SUPPORTED pela v5_fixed.
PIPELINE_VERSION=v7
RETRIEVAL_MODE=dense
APP_ENV=development
LOG_LEVEL=INFO

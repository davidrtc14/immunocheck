# Serviço systemd do modo demonstração (ADR-057). Ver docs/DEMO_REMOTE.md.
[Unit]
Description=ImmunoCheck - bot de demonstração (LLM por API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/immunocheck
EnvironmentFile=/home/ubuntu/immunocheck/.env.demo
ExecStart=/home/ubuntu/immunocheck/.venv/bin/immunocheck-telegram
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
